# Vault
VAULT_TOKEN="<your-vault-root-token>"
VAULT_ROOT_DEV_TOKEN="<your-vault-root-token>"
VAULT_MOUNT_PATH="tde/data/global-key"
VAULT_ADDR="http://vault:8200"

# pgBackRest Envelope Key (KEK in Vault, DEK in /data/db)
VAULT_KEK_PATH=pgbackrest/kek
VAULT_SECRET_MOUNT=secret
DEK_FILE=/data/db/pgbackrest_dek.enc
DEK_META_FILE=/data/db/pgbackrest_dek.meta

# Postgres
DB_USER=someone
DB_PASSWORD=password_secure
DB_DEV_USER=someone_dev
DB_DEV_PASSWORD=dev_password_secure

# Postgres Patroni
PATRONI_PG_SUPERUSER=postgres
PATRONI_PG_PASSWORD=postgres_password_secure
PATRONI_PG_REPLICATION_USERNAME=replicator
PATRONI_PG_REPLICATION_PASSWORD=repl_password_secure

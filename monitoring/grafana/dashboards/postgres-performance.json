      "targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"editorMode":"code","expr":"sum(pgbouncer_pools_server_active_connections{instance=\"$pgbouncer_instance\"})","instant":true,"range":false,"legendFormat":"Server Active","refId":"A"}],

      "gridPos":{"h":4,"w":6,"x":18,"y":35},"id":27,
      "options":{"colorMode":"value","graphMode":"none","justifyMode":"center","orientation":"horizontal","reduceOptions":{"calcs":["lastNotNull"],"fields":"","values":false},"textMode":"value"},
      "targets":[{"datasource":{"type":"prometheus","uid":"Prometheus"},"editorMode":"code","expr":"sum(pgbouncer_pools_server_idle_connections{instance=\"$pgbouncer_instance\"})","instant":true,"range":false,"legendFormat":"Server Idle","refId":"A"}],
      "title":"Idle Server Conns (PgBouncer)","type":"stat"

      "fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"drawStyle":"line","fillOpacity":10,"lineWidth":2},"mappings":[],"unit":"short"},"overrides":[{"matcher":{"id":"byName","options":"Active Clients"},"properties":[{"id":"color","value":{"fixedColor":"green","mode":"fixed"}}]},{"matcher":{"id":"byName","options":"Waiting Clients"},"properties":[{"id":"color","value":{"fixedColor":"red","mode":"fixed"}}]}]},
      "gridPos":{"h":7,"w":12,"x":0,"y":39},"id":28,
      "options":{"legend":{"calcs":["max","lastNotNull"],"displayMode":"list","placement":"bottom","showLegend":true},"tooltip":{"mode":"multi","sort":"desc"}},
      "targets":[
        {"datasource":{"type":"prometheus","uid":"Prometheus"},"editorMode":"code","expr":"sum(pgbouncer_pools_client_active_connections{instance=\"$pgbouncer_instance\"})","legendFormat":"Active Clients","range":true,"refId":"A"},

{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "datasource", "uid": "grafana" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" }] },
  "editable": true, "fiscalYearStartMonth": 0, "graphTooltip": 1, "id": null, "links": [], "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100,
      "title": "Cluster Node Status", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "All nodes in the cluster with their role, status, uptime, active connections, and version — in one table. No instance filter needed.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "left", "displayMode": "auto", "filterable": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Status" }, "properties": [{ "id": "custom.width", "value": 80 }, { "id": "custom.displayMode", "value": "color-background-solid" }, { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "Role" }, "properties": [{ "id": "custom.width", "value": 100 }, { "id": "custom.displayMode", "value": "color-background-solid" }, { "id": "mappings", "value": [{ "options": { "master": { "color": "green", "text": "MASTER" }, "replica": { "color": "blue", "text": "REPLICA" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "Uptime" }, "properties": [{ "id": "unit", "value": "dtdhms" }, { "id": "custom.width", "value": 140 }] },
          { "matcher": { "id": "byName", "options": "Active Conns" }, "properties": [{ "id": "custom.width", "value": 110 }, { "id": "custom.displayMode", "value": "color-background-solid" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 90 }] } }] },
          { "matcher": { "id": "byName", "options": "Node" }, "properties": [{ "id": "custom.width", "value": 160 }] }
        ]
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 }, "id": 1,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "pg_up{cluster=\"$cluster\"}", "format": "table", "instant": true, "range": false, "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "time() - pg_postmaster_start_time_seconds{cluster=\"$cluster\"}", "format": "table", "instant": true, "range": false, "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "sum by (instance) (pg_stat_activity_count{cluster=\"$cluster\", state=\"active\"})", "format": "table", "instant": true, "range": false, "refId": "C" }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "instance", "mode": "outer" } },
        { "id": "filterFieldsByName", "options": { "include": { "names": ["instance", "role", "Value #A", "Value #B", "Value #C"] } } },
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": { "instance": 0, "role": 1, "Value #A": 2, "Value #B": 3, "Value #C": 4 }, "renameByName": { "instance": "Node", "role": "Role", "Value #A": "Status", "Value #B": "Uptime", "Value #C": "Active Conns" } } }
      ],
      "title": "Node Overview Table", "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "id": 200,
      "title": "Cluster-wide Comparisons", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "TPS (commits/sec) per node — compare master vs replica workload.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "mappings": [], "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 }, "id": 10,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "sum by (instance) (rate(pg_stat_database_xact_commit{cluster=\"$cluster\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "TPS per Node", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Active connections per node over time.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "mappings": [], "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 }, "id": 11,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "sum by (instance, state) (pg_stat_activity_count{cluster=\"$cluster\"})", "legendFormat": "{{instance}} — {{state}}", "range": true, "refId": "A" }],
      "title": "Connections per Node", "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }, "id": 300,
      "title": "Replication Health", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "WAL replication lag per replica in bytes. Only the primary/master node exposes this.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 16777216 }, { "color": "red", "value": 67108864 }] }, "unit": "decbytes" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 16 }, "id": 20,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "vertical", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "valueAndName" },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "pg_stat_replication_pg_wal_lsn_diff{cluster=\"$cluster\"}", "instant": true, "range": false, "legendFormat": "{{client_addr}} ({{application_name}})", "refId": "A" }],
      "title": "Replication Lag (Current)", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "WAL replication lag per replica over time.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }, "mappings": [], "unit": "decbytes" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 16, "x": 8, "y": 16 }, "id": 21,
      "options": { "legend": { "calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "pg_stat_replication_pg_wal_lsn_diff{cluster=\"$cluster\"}", "legendFormat": "→ {{client_addr}} ({{application_name}})", "range": true, "refId": "A" }],
      "title": "Replication Lag over Time", "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }, "id": 400,
      "title": "Resource Usage (All Nodes)", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "CPU usage % per node — compare load across the cluster.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2 }, "mappings": [], "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 }, "id": 30,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{cluster=\"$cluster\", mode=\"idle\"}[$__rate_interval])) * 100)", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "CPU Usage % per Node", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "description": "Memory used % per node.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 8, "lineWidth": 2 }, "mappings": [], "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 }, "id": 31,
      "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "editorMode": "code", "expr": "(1 - node_memory_MemAvailable_bytes{cluster=\"$cluster\"} / node_memory_MemTotal_bytes{cluster=\"$cluster\"}) * 100", "legendFormat": "{{instance}}", "range": true, "refId": "A" }],
      "title": "Memory Usage % per Node", "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["postgresql", "patroni", "overview", "prometheus"],
  "templating": {
    "list": [
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "definition": "label_values(pg_up, cluster)",
        "hide": 0, "includeAll": false, "label": "Cluster", "multi": false, "name": "cluster", "options": [],
        "query": { "query": "label_values(pg_up, cluster)", "refId": "StandardVariableQuery" },
        "refresh": 2, "regex": "", "skipUrlSync": false, "sort": 1, "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h", "2h", "1d"] },
  "timezone": "browser",
  "title": "PostgreSQL Cluster Overview",
  "uid": "postgres_overview",
  "version": 1
}

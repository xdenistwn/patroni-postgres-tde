FROM ubuntu:24.04

# Avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install prerequisites and PGDG apt repository (arm64 / aarch64)
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    lsb-release \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
  && echo "deb [arch=arm64 signed-by=/usr/share/keyrings/postgresql.gpg] \
      https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update

# Install PostgreSQL 18 and extensions
RUN apt-get install -y --no-install-recommends \
    percona-postgresql-18 \
    postgresql-client-18 \
    postgresql-18-pg-partman \
    postgresql-18-repack \
    postgresql-18-cron \
    postgresql-18-audit \
    pgbouncer \
    pgbackrest \
    python3-pip \
    python3-dev \
    wget \
    jq \
    git \
    make \
    lz4 \
    zstd \
    net-tools

# Install Patroni
USER postgres
RUN pip3 install --break-system-packages patroni[etcd3]

# Clean up build-time dependencies to keep the image slim
USER root
RUN apt-get remove -y \
    python3-dev \
    wget \
    git \
    make \
  && apt-get autoremove -y \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Create necessary directories
RUN mkdir -p /etc/patroni /data/db /data/pg_tde_keys \
  && mkdir -p /etc/postgresql/secrets \
  && touch /etc/postgresql/secrets/vault_token.txt \
  && mkdir -p /etc/pgbouncer \
  && chown -R postgres:postgres /etc/patroni /data /etc/postgresql /etc/pgbouncer \
  && chmod 700 /data/db /data/pg_tde_keys \
  && chmod 600 /etc/postgresql/secrets/vault_token.txt

# Copy entrypoint and helper scripts
COPY entrypoint-postgres.sh /entrypoint.sh
COPY patroni-tde-basebackup.sh /usr/local/bin/patroni-tde-basebackup.sh
RUN chmod +x /entrypoint.sh /usr/local/bin/patroni-tde-basebackup.sh

# Expose PostgreSQL, Patroni, and PgBouncer ports
USER postgres
EXPOSE 5432 6432 8008

ENTRYPOINT ["/entrypoint.sh"]
CMD ["patroni", "/etc/patroni/patroni.yml"]
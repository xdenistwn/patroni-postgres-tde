# ============================================================
# HAProxy — Laravel Multi-Tenant Environment Variables
# ============================================================

# General Gateway setting
DB_HOST_PROXY=haproxy

# Tenant A settings
DB_CONNECTION=tenant_a
DB_PORT_A_RW=5001
DB_PORT_A_RO=5101
DB_DATABASE_A=app_tenant_a
DB_USERNAME_A=app_user
DB_PASSWORD_A=secure_password

# Tenant B settings (To be assigned dynamically by app state)
DB_PORT_B_RW=5002
DB_PORT_B_RO=5102
DB_DATABASE_B=app_tenant_b
DB_USERNAME_B=app_user
DB_PASSWORD_B=secure_password
